PORT=5000
NODE_ENV=development

# Local MongoDB URI
MONGO_URI=mongodb://localhost:27017/bookmystay

# JWT Secrets (replace with long random strings)
JWT_SECRET=replace_with_32+_char_random_string
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=replace_with_another_32+_char_random_string
REFRESH_TOKEN_EXPIRE=7d

# Frontend URL for emails and CORS
FRONTEND_URL=http://localhost:5173

# Email SMTP Settings (e.g. Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
FROM_EMAIL=noreply@bookmystay.com
FROM_NAME=BookMyStay

# Cloudinary (get from cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # From Stripe CLI: stripe listen --forward-to localhost:5000/api/v1/payments/stripe/webhook

# Razorpay (get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
